# Copy to .env for local use. On your host (Railway, Render...) set these as environment
# variables instead. Never commit real values.

# Postgres (Supabase, Neon, or the host's own Postgres)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Meta app: developers.facebook.com → your app → App settings → Basic
META_APP_ID=
META_APP_SECRET=
# Any string you invent. Paste the same string into the Webhooks setup in the App Dashboard.
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0

# One Page access token per business, named as in that business file's page_token_env.
# Get them with: npm run cli -- meta:pages <user-token>
PAGE_TOKEN_MY_BUSINESS=
PAGE_TOKEN_MY_CLIENT=

# Claude (console.anthropic.com → API keys). Without it, funnels run and the AI is off.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Global kill switch. Nothing real is sent until this is true (and the business has live: true).
LIVE_SENDING=false

# Your public URL, e.g. https://social-agent-production.up.railway.app (for click tracking)
PUBLIC_URL=

# /admin dashboard login: user "admin" + this password. Admin is off when empty.
ADMIN_PASSWORD=

# Alerts (hot leads, handoffs, broken funnels). Telegram, and/or any Slack/Discord/Make webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# Shown on /privacy and /data-deletion (Meta needs both URLs to switch the app Live)
OPERATOR_NAME=
OPERATOR_EMAIL=
