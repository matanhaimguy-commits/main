{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Agent",
      "Workflow",
      "Skill",
      "mcp__Higgs",
      "mcp__Lovable",
      "mcp__ElevenLabs",
      "mcp__Apify",
      "mcp__Firecrawl",
      "mcp__github"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.+__(generate_image|generate_image_batch|generate_video|generate_video_batch|generate_audio|generate_audio_batch|execute_preset|outpaint_image|motion_control|ads_studio_generate|shorts_studio_create|ai_influencer_generate|generate_3d|upscale_image|upscale_video|remove_background|reframe|relight_image|create_voice|create_voice_from_confirmed_audio|voice_change|dubbing|apps_invoke|sandbox_exec|scene_builder_3d_generate_video|scene_builder_3d_generate_angles|scene_builder_3d_run_python|video_analysis_create|virality_predictor|build_ai_influencer|animation_actions|create_website|deploy_website|text_to_video|image_to_video|reference_to_video|create_video_agent|send_video_agent_message|create_video_from_avatar|create_video_from_cinematic_avatar|create_video_from_image|create_video_from_studio|create_video_batch|generate_from_template|create_video_translation|create_video_translation_batch|create_lipsync|create_lipsync_batch|create_ai_clipping|create_filler_word_removal|create_image_generation|create_digital_twin|create_photo_avatar|create_prompt_avatar|create_look_pack_looks|create_template_looks|create_speech|create_speech_without_player|convert_model_speech|clone_voice|design_voice|create_instant_audio_voice|create_model_audio_voice)|mcp__.+__creative_(generate_speech|generate_image|edit_image|generate_video|generate_in_flow|run_flow_nodes|design_voice|transcribe_audio)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/generation_gate.py\"",
            "timeout": 30,
            "onFailure": "block",
            "statusMessage": "Checking the production gates"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/atlas_bash_guard.py\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking for Atlas calls outside the gate"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/heygen_bash_guard.py\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking for HeyGen calls outside the gate"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/secret_guard.py\"",
            "timeout": 20,
            "statusMessage": "Checking for secrets"
          }
        ]
      },
      {
        "matcher": "mcp__.+__call-actor",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/apify_gate.py\"",
            "timeout": 20,
            "onFailure": "block",
            "statusMessage": "Checking the Apify run"
          }
        ]
      }
    ]
  }
}
