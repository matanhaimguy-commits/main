  "human_checkpoints": {
    "G-HUMAN-SPINE": {
      "mode": "delegable",
      "what": "Pick the script spine and the master hook stack (Script Lab 12C). The owner said to run without stopping, so Claude picks, says which and why, and it shows in the queue as FYI."
    },
    "G-HUMAN-VOICE": {
      "mode": "per_voice",
      "what": "Listen once when a voice is cast for a client or series (audition and 15 s pilot). Later pieces with the locked voice pass on the measured take checks."
    },
    "G-HUMAN-LOOK": {
      "mode": "per_series",
      "what": "Approve the look bible (style, character, set and prop sheets) once per client or series; recorded on the client's LIB run."
    },
    "G-HUMAN-HOOKBOARD": {
      "mode": "required",
      "what": "Hook storyboards always go to the owner (VISUAL-QA 6)."
    },
    "G-HUMAN-ESCALATE": {
      "mode": "required",
      "what": "An asset that failed 3 attempts, or a prompt that failed 2 loops."
    },
    "G-HUMAN-FINAL": {
      "mode": "required",
      "what": "Approval on the hub's Content page; nothing posts without it."
    },
    "G-HUMAN-TEST": {
      "mode": "required",
      "what": "A test generation outside a post (a model re-test), with its reason."
    },
    "G-FALLBACK": {
      "mode": "director",
      "what": "Kling 3.0 fallback for one shot after an H3 frame-check fail."
    },
    "G-EXCEPTION": {
      "mode": "required",
      "what": "A model outside the standards for one asset (drama exceptions X5 and up)."
    }
  }
}
