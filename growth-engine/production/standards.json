{
  "_doc": "Production standards: the one numbers file every production skill, reviewer and the generation gate read. Prose and reasons: STANDARDS.md (same folder). Change a number here and in STANDARDS.md together, with a dated line in STANDARDS.md's changelog.",
  "version": "1.0 (15 Oct 2026)",
  "humans": [
    "Matan"
  ],
  "gate_policy": {
    "budget_fresh_hours": 24,
    "retake_buffer": 0.25,
    "max_image_attempts": 3,
    "max_video_attempts": 3,
    "max_prompt_loops": 2,
    "script_release_score": 85,
    "visual_pass": {
      "hero": {
        "critical": 0,
        "major": 0,
        "minor": 0
      },
      "other": {
        "critical": 0,
        "major": 0,
        "minor": 2
      }
    },
    "take_pass": {
      "critical": 0,
      "major": 0
    }
  },
  "asset_types": {
    "character_sheet": {
      "kind": "image",
      "prompt_gate": "G-PROMPT-IMG",
      "visual_gate": "G-VIS-SHEET",
      "hero": true,
      "look": true
    },
    "prop_sheet": {
      "kind": "image",
      "prompt_gate": "G-PROMPT-IMG",
      "visual_gate": "G-VIS-SHEET",
      "hero": true,
      "look": true
    },
    "set_sheet": {
      "kind": "image",
      "prompt_gate": "G-PROMPT-IMG",
      "visual_gate": "G-VIS-SHEET",
      "hero": true,
      "look": true
    },
    "style_ref": {
      "kind": "image",
      "prompt_gate": "G-PROMPT-IMG",
      "visual_gate": "G-VIS-SHEET",
      "hero": true,
      "look": true
    },
    "storyboard": {
      "kind": "image",
      "prompt_gate": "G-PROMPT-IMG",
      "visual_gate": "G-VIS-BOARD",
      "hero": false
    },
    "start_frame": {
      "kind": "image",
      "prompt_gate": "G-PROMPT-IMG",
      "visual_gate": "G-VIS",
      "hero": true
    },
    "still": {
      "kind": "image",
      "prompt_gate": "G-PROMPT-IMG",
      "visual_gate": "G-VIS",
      "hero": false
    },
    "slide": {
      "kind": "image",
      "prompt_gate": "G-PROMPT-IMG",
      "visual_gate": "G-VIS-SLIDE",
      "hero": false
    },
    "cover": {
      "kind": "image",
      "prompt_gate": "G-PROMPT-IMG",
      "visual_gate": "G-VIS-SLIDE",
      "hero": true
    },
    "static": {
      "kind": "image",
      "prompt_gate": "G-PROMPT-IMG",
      "visual_gate": "G-VIS",
      "hero": true
    },
    "video_clip": {
      "kind": "video",
      "prompt_gate": "G-PROMPT-VID",
      "visual_gate": "G-TAKE"
    },
    "motion_render": {
      "kind": "code",
      "visual_gate": "G-MOTION-FRAMES"
    },
    "voice": {
      "kind": "audio",
      "audio_gate": "G-AUDIO"
    },
    "audio_slice": {
      "kind": "audio",
      "audio_gate": "G-AUDIO"
    },
    "song": {
      "kind": "audio",
      "audio_gate": "G-AUDIO"
    },
    "music": {
      "kind": "audio",
      "audio_gate": "G-AUDIO"
    },
    "sfx": {
      "kind": "audio",
      "audio_gate": "G-AUDIO"
    },
    "final": {
      "kind": "final",
      "visual_gate": "G-FINAL"
    },
    "test": {
      "kind": "test"
    }
  },
  "models": {
    "image": {
      "gpt_image_2_5": {
        "use": [
          "slide",
          "cover",
          "static",
          "still",
          "start_frame",
          "style_ref",
          "storyboard",
          "character_sheet",
          "prop_sheet",
          "set_sheet"
        ],
        "note": "Carousels, statics, stylized sheets and storyboards. Faces of realistic people: gpt_image_2 instead (2.5 looked plastic, Oct 2026)."
      },
      "gpt_image_2": {
        "use": [
          "character_sheet",
          "still",
          "start_frame",
          "storyboard",
          "prop_sheet",
          "set_sheet"
        ],
        "params": {
          "quality": "high",
          "resolution": "2k"
        },
        "media_role": "image",
        "note": "Realistic people, always with a reference photo (hub G7)."
      },
      "nano_banana_2": {
        "use": [
          "character_sheet",
          "prop_sheet",
          "set_sheet",
          "storyboard",
          "still",
          "start_frame"
        ],
        "media_role": "image_references",
        "note": "Stylized sheets and storyboards (animation, song). Pending the side-by-side test against gpt_image_2_5 (STANDARDS.md R1)."
      },
      "nano_banana_pro": {
        "use": [
          "storyboard"
        ],
        "media_role": "image_references",
        "note": "Multi-panel storyboards with text-free panels, if the side-by-side picks it."
      }
    },
    "video": {
      "minimax_h3": {
        "resolution": "2K",
        "aspect_ratio": "9:16",
        "declined_preset_id": "24bae836-2c4a-48e0-89b6-49fcc0b21612",
        "min_s": 5,
        "max_s": 15,
        "credits_per_s": 2
      },
      "kling3_0": {
        "needs_gate": "G-FALLBACK",
        "declined_preset_id": "24bae836-2c4a-48e0-89b6-49fcc0b21612",
        "credits_per_5s": 10,
        "note": "Silent start-to-end transformation only, after an H3 keyframe take failed the frame check (hub G2)."
      }
    },
    "elevenlabs": {
      "tts": [
        "eleven_v4",
        "eleven_v3"
      ],
      "music": [
        "eleven_music_v2_5"
      ],
      "sfx": [
        "eleven_text_to_sound_v2"
      ],
      "image": [],
      "video": [],
      "note": "ElevenLabs image and video models are not on the list: images come from Higgsfield (G7), video from H3 (G1). A drama exception (X5 and up) needs G-EXCEPTION on the asset."
    },
    "higgs_audio": {
      "allowed": [],
      "note": "Higgsfield speech is retired for our content (hub G8): voices, music and SFX come from ElevenLabs."
    }
  },
