      "kind": "nodes"
    }
  },
  "families": {
    "_doc": "Which pipeline steps (AI-VIDEO-PIPELINE.md section 1) apply to which production family. Formats in config/organic.json name their family in 'production'.",
    "still": {
      "na_steps": [
        4,
        5,
        8,
        12
      ],
      "note": "Single images and carousels: step 3 is the slide copy, step 10 the slide generation, step 11 G-VIS-SLIDE, step 13 G-SET."
    },
    "motion": {
      "na_steps": [],
      "note": "Code-rendered reels (HyperFrames): step 8 = preview frames, step 10 = render, step 11 = G-MOTION-FRAMES."
    },
    "keyframe_reel": {
      "na_steps": [
        8
      ],
      "note": "Tier C quote reel: one silent H3 keyframe shot from a passed start frame, voice and captions in the edit. No storyboard: one shot, no mouth."
    },
    "ai_video": {
      "na_steps": [],
      "note": "Talking head, UGC, narrated story, animation, song, podcast, drama: every step."
    },
    "real": {
      "na_steps": [
        7,
        8,
        9,
        10
      ],
      "note": "Real footage (the owner films): no look bible, storyboard, credits or generation; steps 11 to 13 still check the takes, words and final cut."
    }
  },
