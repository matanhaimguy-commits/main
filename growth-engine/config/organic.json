  "story_templates": {
    "_doc": "Narrative shapes (STORY-FORMATS.md). A Post Card names one in story_template; the format renders it. Beats are the default order; Script Lab structure codes in parentheses.",
    "pov_day": {
      "name": "POV: a day in the buyer's life",
      "beliefs": [
        "B1",
        "B2",
        "B3"
      ],
      "jobs": [
        "reach",
        "trust"
      ],
      "script_lab": [
        "ST3",
        "ST4"
      ],
      "beats": [
        "cold open on the pain moment, in the buyer's words (0 to 3 s)",
        "the day so far: 2 or 3 accommodations, each a picture",
        "the failed fix and why it failed",
        "the breaking point",
        "the revelation: the hidden cause shown as THE PICTURE, then the mechanism (UMS) in one line",
        "the same moment, lived differently",
        "organic CTA (follow for part 2, save, send, comment keyword)"
      ]
    },
    "two_days": {
      "name": "Same morning, two owners",
      "beliefs": [
        "B2",
        "B3",
        "B5"
      ],
      "jobs": [
        "reach",
        "trust"
      ],
      "script_lab": [
        "ST5"
      ],
      "beats": [
        "split: two owners, same moment",
        "their days diverge on one decision",
        "the one difference named (the mechanism)",
        "where each is at night",
        "organic CTA"
      ]
    },
    "hidden_villain": {
      "name": "The problem is a character",
      "beliefs": [
        "B1",
        "B2"
      ],
      "jobs": [
        "reach"
      ],
      "script_lab": [
        "ST3"
      ],
      "beats": [
        "the villain (the unanswered DM, the dead boost button) speaks from where it lives",
        "it mocks the failed fix",
        "it brags about what it costs the owner",
        "the mechanism arrives and the villain loses",
        "organic CTA"
      ],
      "note": "Comic, never shaming the owner. Best as a recurring animated series character."
    },
    "object_speaks": {
      "name": "An object in the business tells its story",
      "beliefs": [
        "B1",
        "B3"
      ],
      "jobs": [
        "reach",
        "trust"
      ],
      "script_lab": [
        "ST3"
      ],
      "beats": [
