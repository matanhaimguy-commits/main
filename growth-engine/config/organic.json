  "animation_styles": {
    "_doc": "Locked style blocks for animated story formats. The style name is a look, never a studio's characters, logos or names on screen (VISUAL-QA V24). Image model per STANDARDS.md R1.",
    "claymation": {
      "name": "Claymation (stop-motion clay)",
      "block": "Handmade claymation stop-motion look: plasticine characters with visible thumbprints and slight tool marks, soft rounded forms, miniature handmade set pieces, warm practical lighting, shallow depth of field like a tabletop set, gentle stop-motion texture."
    },
    "crochet": {
      "name": "Crochet / amigurumi",
      "block": "Crochet amigurumi look: characters and props knitted from soft yarn with visible stitches, safety-bead eyes, felt details, a cosy miniature yarn world, soft daylight, shallow depth of field."
    },
    "pixar_style_3d": {
      "name": "3D family-film style",
      "block": "Polished 3D family-film animation look: expressive stylised characters with large eyes and soft subsurface skin, rounded shapes, warm cinematic lighting with soft bounce, rich but controlled colour, gentle depth of field.",
      "note": "Say \"3D family-film animation\"; never name or imitate a studio's characters."
    },
    "disney_style_2d": {
      "name": "2D hand-drawn storybook style",
      "block": "Classic hand-drawn 2D animation look: clean ink lines, painted watercolour backgrounds, expressive squash-and-stretch poses, warm storybook palette, soft vignette.",
      "note": "Say \"hand-drawn 2D storybook animation\"; never name or imitate a studio's characters."
    }
  }
